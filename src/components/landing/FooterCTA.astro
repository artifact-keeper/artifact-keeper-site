---
import EnterpriseContact from './EnterpriseContact.astro';
---
<section class="final" aria-labelledby="ch8">
  <div class="wrap">
    <svg class="mark" viewBox="0 0 512 512" aria-hidden="true"><use href="#ak-shield"/></svg>
    <h2 id="ch8">Ready to know your blast radius?</h2>
    <p>One Compose file or one Helm chart. Five minutes to your first repository.</p>
    <p class="oss-line">MIT licensed. Every feature ships in the open-source release, with no enterprise edition.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#deploy">Deploy in 5 minutes</a>
      <a class="btn btn-ghost" href="/docs/">Read the docs</a>
      <a class="btn btn-ghost" href="https://github.com/artifact-keeper/artifact-keeper" target="_blank" rel="noopener">View on GitHub</a>
    </div>
    <EnterpriseContact variant="inline" />
  </div>
</section>
