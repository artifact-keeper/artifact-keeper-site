---
// OpenTeams lockup, inlined so it takes the surrounding text colour (currentColor).
// White on the dark theme, navy on the light theme; on "screen" panels set color to var(--s-ink).
import raw from '../../assets/openteams-logo.svg?raw';

interface Props {
  /** CSS height of the lockup; width follows the 1724:331 aspect ratio (viewBox cropped to the artwork). */
  height?: string;
  class?: string;
}
const { height = '22px', class: cls } = Astro.props;
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg
  class:list={['ot-logo', cls]}
  viewBox="15 76 1724 331"
  fill="currentColor"
  role="img"
  aria-label="OpenTeams"
  style={`height:${height};width:auto`}
  set:html={`<title>OpenTeams</title>${inner}`}
/>
