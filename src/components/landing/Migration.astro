---
// Chapter 6 teaser. The full migration chapter lives on /migrate/ (MigrationDetail.astro).
const steps = ['Connect', 'Select', 'Run', 'Verify'];
---
<section class="band alt" id="migrate" aria-labelledby="ch5">
  <div class="wrap">
    <div class="chap-head">
      <span class="eyebrow"><span class="pip"></span>Chapter 6 <span class="sep">·</span> Migration</span>
      <p class="kicker">Leave Artifactory without a migration project.</p>
      <h2 class="h2" id="ch5">Point it at Artifactory or Nexus. It copies, you verify.</h2>
    </div>
    <div class="migt">
      <ol class="mini four" aria-label="Four steps">
        {steps.map((name, i) => (
          <li style={`--i:${i}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M7 12.5l3.2 3.2L17 9"/></svg>
            <span>{name}</span>
          </li>
        ))}
      </ol>
      <div class="facts">
        <div><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg>Read-only against the source</div>
        <div><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg>Resumes interrupted runs</div>
        <div><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg>Preserves metadata</div>
        <div><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg>Repositories and artifacts, plus users and permissions from Artifactory</div>
      </div>
      <a class="explore" href="/migrate/">See how migration works <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
    </div>
  </div>
</section>
