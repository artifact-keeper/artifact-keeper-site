---
import { HERO } from '../../lib/landing-svg';
import { release } from '../../data/site';
import { stats } from '../../data/stats';
// Proof-row numbers come from the stats repo at build time, rounded down so they never overstate.
const starsFloor = Math.floor(stats.metrics.stars / 100) * 100;
const pullsK = Math.floor(stats.metrics.dockerPullsBackend / 10000) * 10;
---
<section class="hero" id="hero" aria-labelledby="h1">
  <div class="wrap">
    <div class="hero-copy">
      <span class="eyebrow"><span class="pip"></span>Open-source artifact registry <span class="sep">·</span> {release.version} <span class="sep">·</span> MIT</span>
      <h1 id="h1">The artifact registry that <em>knows who's exposed.</em></h1>
      <p class="sub">One Rust server for <b>37 package formats</b>. Every upstream package gated before a developer sees it. Every download attributed. When a CVE lands you get repositories, users and IPs, not guesses.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#deploy">Deploy in 5 minutes <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        <a class="btn btn-ghost" href="https://demo.artifactkeeper.com" target="_blank" rel="noopener">Open the live demo <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 3h7v7M13 3L4 12"/></svg></a>
      </div>
      <button class="watch" type="button" id="watch" aria-haspopup="dialog" aria-controls="promo"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M10 8.5v7l6-3.5z"/></svg>Watch the 68-second story</button>
    </div>

    <div class="stage-hero">
      <Fragment set:html={HERO} />
      <p class="hero-src">npmjs.org · pypi.org · Maven Central · Docker Hub · huggingface.co</p>
      <div class="ticker" aria-label="Download attribution log, example data">
        <span class="tag">example data</span>
        <div class="ticker-win">
          <ul class="ticker-track">
            <li><span class="t">09:12:04</span><span class="m">GET</span><span class="p">npm/lodash/-/lodash-4.17.21.tgz</span><span class="s">200</span><span class="u">ci-bot@github-runner-14</span><span class="ip">10.40.2.17</span></li>
            <li><span class="t">09:12:05</span><span class="m put">PUT</span><span class="p">docker/v2/api/manifests/1.9.3</span><span class="s">201</span><span class="u">alice</span><span class="ip">10.40.7.3</span></li>
            <li><span class="t">09:12:09</span><span class="m">GET</span><span class="p">pypi/simple/requests/</span><span class="s">200</span><span class="u">anonymous</span><span class="ip">203.0.113.9</span></li>
            <li aria-hidden="true"><span class="t">09:12:04</span><span class="m">GET</span><span class="p">npm/lodash/-/lodash-4.17.21.tgz</span><span class="s">200</span><span class="u">ci-bot@github-runner-14</span><span class="ip">10.40.2.17</span></li>
            <li aria-hidden="true"><span class="t">09:12:05</span><span class="m put">PUT</span><span class="p">docker/v2/api/manifests/1.9.3</span><span class="s">201</span><span class="u">alice</span><span class="ip">10.40.7.3</span></li>
            <li aria-hidden="true"><span class="t">09:12:09</span><span class="m">GET</span><span class="p">pypi/simple/requests/</span><span class="s">200</span><span class="u">anonymous</span><span class="ip">203.0.113.9</span></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="proof">
      <span><b>{release.version}</b></span>
      <span><b>MIT</b> licensed</span>
      <span><b class="tnum" data-count={starsFloor} data-suffix="+" data-fmt="comma">{starsFloor.toLocaleString("en-US")}+</b> GitHub stars</span>
      <span><b class="tnum" data-count={pullsK} data-suffix="K+">{pullsK}K+</b> backend pulls on Docker Hub</span>
      <span><b>Rust</b> + <b>PostgreSQL</b></span>
    </div>
    <p class="proof-note">GitHub stars checked 2026-11-02 · Docker Hub pulls checked 2026-10-30</p>
  </div>
  <dialog class="promo" id="promo" aria-labelledby="promo-title">
    <div class="promo-bar">
      <span id="promo-title">Artifact Keeper in 68 seconds</span>
      <button class="promo-close" type="button" id="promo-close" aria-label="Close video"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <video controls preload="none" playsinline poster="/landing-promo-poster.jpg" src="/landing-promo-720p.mp4" width="1280" height="720"></video>
  </dialog>
</section>
