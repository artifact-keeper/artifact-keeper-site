---
import { contacts, release } from '../../data/site';
import OpenTeamsLogo from './OpenTeamsLogo.astro';

interface Props {
  /** True on the home page, where the brand link scrolls back to the top. */
  home?: boolean;
}
const { home = false } = Astro.props;
---
<footer>
  <div class="wrap foot">
    <div>
      <a class="brand" href={home ? '#top' : '/'}><svg viewBox="0 0 512 512" aria-hidden="true"><use href="#ak-shield"/></svg><span>Artifact Keeper</span></a>
      <nav aria-label="Footer" style="margin-top:20px"><ul>
        <li><a href="/docs/">Docs</a></li>
        <li><a href="/security/">Security</a></li>
        <li><a href="/use-cases/">Use cases</a></li>
        <li><a href="/migrate/">Migrate</a></li>
        <li><a href="https://github.com/artifact-keeper/artifact-keeper" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="https://demo.artifactkeeper.com" target="_blank" rel="noopener">Demo</a></li>
        <li><a href="/cloud/">Cloud <span class="nav-pill">waitlist</span></a></li>
        <li><a href={contacts.openteams} target="_blank" rel="noopener">Support</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul></nav>
      <a class="ot-by" href={contacts.openteams} target="_blank" rel="noopener"><span>Enterprise support by</span><OpenTeamsLogo height="18px" /></a>
      <div class="legal">
        <p>Community and product questions: <span class="addr">{contacts.support}</span></p>
        <p>Scanning by Trivy, Grype, OpenSCAP and OWASP Dependency-Track. Search by OpenSearch. Database by PostgreSQL.</p>
        <p>Format logos are Simple Icons (CC0); the marks belong to their owners. JFrog and Artifactory are trademarks of JFrog Ltd; Nexus is a trademark of Sonatype. Artifact Keeper is not affiliated.</p>
      </div>
    </div>
    <div class="ver">{release.version} · {release.date}<br>MIT licensed</div>
  </div>
</footer>
