---
// Chapter 2 teaser. The pipeline animation and gate cards live on /security/#gates (GatesDetail.astro).
const gates = [
  ['01', 'Age gate', 'min_age_days: 7'],
  ['02', 'Curation', 'package_pattern: "evil-*"'],
  ['03', 'Scan', 'Trivy + Grype → A–F'],
  ['04', 'Policy', 'action: block'],
  ['05', 'Quality gate', 'min_health_score: 75'],
  ['06', 'Promote', 'staging → release'],
];
---
<section class="band alt" id="gates" aria-labelledby="ch2">
  <div class="wrap">
    <div class="chap-head">
      <span class="eyebrow"><span class="pip"></span>Chapter 2 <span class="sep">·</span> The gates</span>
      <p class="kicker">It should never have gotten in.</p>
      <h2 class="h2" id="ch2">Six gates between the internet and your build.</h2>
      <p class="lead">Each one is a feature of the registry, not a bolt-on. Packages that fail are refused with a real HTTP status your package manager understands.</p>
    </div>
    <ol class="gtiles mini-ticks" id="gtiles">
      {gates.map(([n, name, cfg], i) => (
        <li style={`--i:${i}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M7 12.5l3.2 3.2L17 9"/></svg>
          <div><span class="idx">GATE {n}</span><b>{name}</b><code>{cfg}</code></div>
        </li>
      ))}
    </ol>
    <a class="explore" href="/security/#gates">See the gates in motion <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
  </div>
</section>
