---
import NavLinkItems from './NavLinkItems.astro';

interface Props {
  /** Solid (glass) bar from the start, for pages without the dark hero. */
  solid?: boolean;
  /** Current page path, to mark the active nav item on secondary pages. */
  current?: string;
}
const { solid = false, current = '' } = Astro.props;
// Chapter anchors live on the home page; elsewhere they point back to it.
const home = !solid;
const a = (href: string) => (href.startsWith('#') && !home ? '/' + href : href);
---
<header class:list={["nav", { top: !solid }]} id="nav" data-hero={solid ? undefined : ""}>
  <div class="wrap">
    <a class="brand" href={home ? "#top" : "/"} aria-label={home ? "Artifact Keeper, back to top" : "Artifact Keeper home"}><svg viewBox="0 0 512 512" aria-hidden="true"><use href="#ak-shield"/></svg><span>Artifact Keeper</span></a>
    <ul class="nav-links"><NavLinkItems current={current} home={home} /></ul>
    <div class="nav-right">
      <button class="icon-btn nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="nt-open" d="M4 7h16M4 12h16M4 17h16"/><path class="nt-close" d="M6 6l12 12M18 6L6 18"/></svg></button>
      <a class="icon-btn" href="https://github.com/artifact-keeper/artifact-keeper" target="_blank" rel="noopener" aria-label="Artifact Keeper on GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"/></svg></a>
      <button class="icon-btn" id="theme" type="button" aria-label="Switch colour theme"><svg class="theme-ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg><svg class="theme-ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
      <a class="btn btn-primary" href={a("#deploy")}>Deploy</a>
    </div>
  </div>
  <nav class="nav-menu" id="nav-menu" aria-label="Site" hidden>
    <ul class="wrap"><NavLinkItems current={current} home={home} /></ul>
  </nav>
</header>

<script>
  // Theme: the inline head script already set data-theme (dark or light) before first paint.
  const root = document.documentElement;
  document.getElementById('theme')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { localStorage.setItem('ak-theme', next); } catch (e) {}
  });

  const nav = document.getElementById('nav');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const menuOpen = () => !!menu && !menu.hidden;

  // Nav: transparent over the hero, glass after (and while the mobile menu is open).
  // Pages without a hero render it solid.
  if (nav && nav.hasAttribute('data-hero')) {
    const onScroll = () => nav.classList.toggle('top', window.scrollY < 40 && !menuOpen());
    nav.addEventListener('nav:sync', onScroll);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    const hero = document.getElementById('hero');
    if (hero && 'IntersectionObserver' in window) {
      new IntersectionObserver((es) => {
        nav.classList.toggle('top', es[0].intersectionRatio > 0.9 && window.scrollY < 40 && !menuOpen());
      }, { threshold: [0, 0.9, 1] }).observe(hero);
    }
  }

  // Mobile menu (below 900px): closes on a link click, Escape, or the viewport growing past 900px.
  if (nav && toggle && menu) {
    const setOpen = (open: boolean, refocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      nav.classList.toggle('menu-open', open);
      nav.dispatchEvent(new Event('nav:sync'));
      if (!open && refocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(!menuOpen()));
    menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menuOpen()) setOpen(false, true); });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => { if (e.matches && menuOpen()) setOpen(false); });
  }
</script>
